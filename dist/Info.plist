<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>crossover-wheel</string>
	<key>CFBundleDisplayName</key>
	<string>crossover-wheel</string>
	<key>CFBundleIdentifier</key>
	<string>it.allard.crossover-wheel</string>
	<key>CFBundleExecutable</key>
	<string>t150menu</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!--
	    A menu bar item, not a windowed application: no Dock icon and no
	    entry in the application switcher. The setup window is still shown
	    on demand, and on first run.
	-->
	<key>LSUIElement</key>
	<true/>
	<!--
	    Twenty six, which is what HANDOFF.md and README.md have called the
	    target from the beginning and the only release any of this has been
	    measured on. RESEARCH.md B6 is the reason it matters rather than a
	    formality: macOS 26 added an fClientSeized check to setReport, and
	    B6 says outright that older IOHIDFamily sources are misleading, so
	    the non-seizing open the daemon is built on was read against this
	    release and no other.

	    Naming a lower floor is not caution, it is a promise. This said 11
	    while bootswitch.c named kIOMainPortDefault, which IOKit renamed
	    from kIOMasterPortDefault in macOS 12: a data symbol, bound by dyld
	    at start, so LaunchServices opened the application on a system where
	    it could only die before main, with a crash report and no menu bar
	    item to explain it. t150d links the same file, so falling back to
	    the command line would not have helped either.

	    APP_CFLAGS carries the matching -mmacosx-version-min so the
	    compiler refuses an API newer than this rather than leaving it to
	    be found by whoever runs it.
	-->
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
</dict>
</plist>
